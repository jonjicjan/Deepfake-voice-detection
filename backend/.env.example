# VoiceShield AI — Production Configuration
# Copy to .env and set values before deployment

# Security (REQUIRED for production)
VOICESHIELD_API_KEY=change-me-to-a-strong-random-key
VOICESHIELD_ADMIN_KEY=change-me-admin-key-separate-from-operator-key

# Server
DEBUG=false
HOST=127.0.0.1
PORT=8000
ENABLE_DOCS=false

# CORS — comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://voiceshield.yourdomain.gov.in

# Limits
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_MINUTE=120
